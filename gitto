#!/bin/sh
set -eu

printUsage() {
  cat >&2 <<'USAGE'
usage: gitto <command> [arguments]

  gitto new <name> [<base>]   make a clone of the canonical checkout
  gitto list                  show every clone beside the canonical
  gitto remove <name>         remove a clone holding nothing unpushed
  gitto doctor [<name>]       report references pointing outside a clone

A clone carries the whole checkout — history, submodules, dependencies, build
output and local files — and shares its blocks with the canonical until either
side writes. Run from the canonical checkout, or from any clone of it.
USAGE
  exit 2
}

cloneUnderConstruction=""

removePartialClone() {
  [ -n "$cloneUnderConstruction" ] || return 0
  partialPath="$cloneUnderConstruction"
  cloneUnderConstruction=""
  rm -rf "$partialPath"
  echo "gitto: removed the partial clone $(basename "$partialPath")" >&2
}

fail() {
  echo "gitto: $1" >&2
  removePartialClone
  exit 1
}

absolutePathOf() {
  (cd "$1" && pwd)
}

repositoryRootOf() {
  git -C "$1" rev-parse --show-toplevel 2>/dev/null
}

resolveCanonical() {
  repositoryRoot=$(repositoryRootOf "$PWD") || fail "not inside a git repository"
  if [ -f "$repositoryRoot/.gitto" ]; then
    recordedCanonical=$(cat "$repositoryRoot/.gitto")
    [ -d "$recordedCanonical" ] || fail "this clone records a canonical that is gone: $recordedCanonical"
    echo "$recordedCanonical"
    return
  fi
  echo "$repositoryRoot"
}

requireIndependentCheckout() {
  checkoutPath="$1"
  [ -d "$checkoutPath/.git" ] && return 0
  fail "the canonical is a git worktree, whose history lives elsewhere: $checkoutPath
      a clone is made from a real clone. run 'git clone' once and use that as the canonical."
}

probeSizeInMegabytes=32
probeSizeInBlocks=$((probeSizeInMegabytes * 1024 * 1024 / 512))

freeBlocksIn() {
  df -b "$1" | awk 'NR == 2 { print $4 }'
}

copyCostsNothing() {
  cloneKind="$1"
  probeSource="$2"
  probeTarget="$3"
  probeDirectory="$4"
  rm -f "$probeTarget"
  freeBlocksBefore=$(freeBlocksIn "$probeDirectory")
  case "$cloneKind" in
    clonefile) /bin/cp -c "$probeSource" "$probeTarget" 2>/dev/null || return 1 ;;
    reflink) cp --reflink=always "$probeSource" "$probeTarget" 2>/dev/null || return 1 ;;
  esac
  freeBlocksAfter=$(freeBlocksIn "$probeDirectory")
  [ $((freeBlocksBefore - freeBlocksAfter)) -lt $((probeSizeInBlocks / 4)) ]
}

resolveCloneCommand() {
  probeDirectory="$1"
  probeSource="$probeDirectory/.gitto-clone-probe"
  probeTarget="$probeDirectory/.gitto-clone-probe-copy"
  dd if=/dev/urandom of="$probeSource" bs=1m count="$probeSizeInMegabytes" 2>/dev/null
  for cloneKind in clonefile reflink; do
    if copyCostsNothing "$cloneKind" "$probeSource" "$probeTarget" "$probeDirectory"; then
      rm -f "$probeSource" "$probeTarget"
      echo "$cloneKind"
      return 0
    fi
  done
  rm -f "$probeSource" "$probeTarget"
  fail "copying here costs the full size, so a clone would too.
      macOS needs APFS; Linux needs btrfs, XFS with reflink=1, or OpenZFS 2.2+.
      ext4 and tmpfs cannot share blocks at all."
}

copyTreeCheaply() {
  cloneKind="$1"
  sourcePath="$2"
  destinationPath="$3"
  cloneErrors=$(mktemp)
  case "$cloneKind" in
    clonefile) /bin/cp -c -R "$sourcePath" "$destinationPath" 2>"$cloneErrors" || true ;;
    reflink) cp --reflink=always -a "$sourcePath" "$destinationPath" 2>"$cloneErrors" || true ;;
  esac
  unexplainedErrors=$(grep -v 'is a socket (not copied)' "$cloneErrors" || true)
  rm -f "$cloneErrors"
  [ -z "$unexplainedErrors" ] || fail "clone reported more than skipped sockets:
$unexplainedErrors"
  [ -d "$destinationPath/.git" ] || fail "clone produced no history at $destinationPath"
}

detachInheritedWorktrees() {
  clonePath="$1"
  inheritedCount=$(git -C "$clonePath" worktree list | wc -l | tr -d ' ')
  [ "$inheritedCount" -gt 1 ] || return 0
  rm -rf "$clonePath/.git/worktrees"
  git -C "$clonePath" worktree prune
  echo "  detached $((inheritedCount - 1)) inherited worktree registrations"
}

repointCanonicalReferences() {
  clonePath="$1"
  canonicalPath="$2"
  configuredHooksPath=$(git -C "$clonePath" config --local --get core.hooksPath || true)
  case "$configuredHooksPath" in
    "$canonicalPath"/*)
      relocatedHooksPath="$clonePath${configuredHooksPath#"$canonicalPath"}"
      git -C "$clonePath" config --local core.hooksPath "$relocatedHooksPath"
      echo "  repointed core.hooksPath at this clone's own hooks"
      ;;
  esac
}

reportCanonicalReferences() {
  clonePath="$1"
  canonicalPath="$2"
  canonicalPrefix="$canonicalPath/"
  remainingReferences=$(
    {
      git -C "$clonePath" config --local --list | grep -F "$canonicalPrefix" | sed 's/^/  git config   /' || true
      find "$clonePath" -maxdepth 4 -type l -not -path '*/.git/*' -not -path '*/node_modules/*' \
        -exec sh -c 'for link; do case $(readlink "$link") in "'"$canonicalPrefix"'"*) echo "  symlink      ${link} -> $(readlink "$link")";; esac; done' _ {} + 2>/dev/null || true
      for activationScript in "$clonePath"/*/bin/activate "$clonePath"/.venv/bin/activate "$clonePath"/venv/bin/activate; do
        [ -f "$activationScript" ] || continue
        grep -qF "$canonicalPrefix" "$activationScript" && echo "  virtualenv   $activationScript"
      done
      git -C "$clonePath" submodule--helper list 2>/dev/null | awk '{print $NF}' | while read -r submodulePath; do
        submoduleGitDirectory=$(git -C "$clonePath/$submodulePath" rev-parse --absolute-git-dir 2>/dev/null) || continue
        [ "${submoduleGitDirectory#"$clonePath"/}" = "$submoduleGitDirectory" ] \
          && echo "  submodule    $submodulePath -> $submoduleGitDirectory"
      done
    } 2>/dev/null
  )
  [ -n "$remainingReferences" ] || return 0
  echo "  still pointing outside this clone:"
  echo "$remainingReferences"
}

nestedWorktreesOf() {
  checkoutPath="$1"
  git -C "$checkoutPath" worktree list --porcelain \
    | awk '/^worktree /{print $2}' \
    | while read -r worktreePath; do
        relativePath="${worktreePath#"$checkoutPath"/}"
        if [ "$relativePath" != "$worktreePath" ]; then
          echo "$relativePath"
        fi
      done
}

dropNestedWorktrees() {
  clonePath="$1"
  nestedWorktrees="$2"
  [ -n "$nestedWorktrees" ] || return 0
  echo "$nestedWorktrees" | while read -r relativePath; do
    [ -n "$relativePath" ] || continue
    rm -rf "$clonePath/$relativePath"
  done
  echo "  dropped $(echo "$nestedWorktrees" | wc -l | tr -d ' ') worktrees the canonical keeps inside itself"
}

excludeCloneMarker() {
  clonePath="$1"
  grep -qxF '/.gitto' "$clonePath/.git/info/exclude" 2>/dev/null && return 0
  echo '/.gitto' >> "$clonePath/.git/info/exclude"
}

reportCarriedChanges() {
  clonePath="$1"
  canonicalPath="$2"
  baseRevision="$3"
  carriedCommits=$(git -C "$clonePath" log --oneline "$baseRevision..HEAD" 2>/dev/null | wc -l | tr -d ' ')
  carriedChanges=$(git -C "$clonePath" status --porcelain | wc -l | tr -d ' ')
  [ "$carriedCommits" = 0 ] && [ "$carriedChanges" = 0 ] && return 0
  echo "  carried from the canonical: $carriedCommits commits, $carriedChanges uncommitted files"
  echo "  they are this clone's copies; the canonical keeps its own"
}

createClone() {
  [ $# -ge 1 ] || printUsage
  cloneName="$1"
  requestedBase="${2:-}"

  canonicalPath=$(resolveCanonical)
  requireIndependentCheckout "$canonicalPath"
  clonePath="$canonicalPath-$cloneName"
  [ -e "$clonePath" ] && fail "already exists: $clonePath"

  cloneKind=$(resolveCloneCommand "$(dirname "$canonicalPath")")
  nestedWorktrees=$(nestedWorktreesOf "$canonicalPath")
  baseRevision=${requestedBase:-$(git -C "$canonicalPath" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)}

  echo "cloning $(basename "$canonicalPath") -> $(basename "$clonePath") by $cloneKind"
  trap 'removePartialClone' EXIT INT TERM
  cloneUnderConstruction="$clonePath"
  copyTreeCheaply "$cloneKind" "$canonicalPath" "$clonePath"
  echo "$canonicalPath" > "$clonePath/.gitto"

  detachInheritedWorktrees "$clonePath"
  dropNestedWorktrees "$clonePath" "$nestedWorktrees"
  repointCanonicalReferences "$clonePath" "$canonicalPath"

  excludeCloneMarker "$clonePath"
  git -C "$clonePath" fetch --quiet origin
  git -C "$clonePath" checkout --quiet -B "$cloneName" "$baseRevision" \
    || fail "the canonical holds changes that collide with $baseRevision.
      commit or drop them there, or make the clone at the canonical's own
      revision, which carries everything as it stands:
        gitto new $cloneName HEAD"
  if [ "$requestedBase" = HEAD ]; then
    echo "  submodules left as the canonical had them"
  else
    git -C "$clonePath" submodule update --quiet --init --recursive
  fi

  cloneUnderConstruction=""
  trap - EXIT INT TERM
  reportCarriedChanges "$clonePath" "$canonicalPath" "$baseRevision"
  reportCanonicalReferences "$clonePath" "$canonicalPath"
  echo "  branch $cloneName on $baseRevision, $(git -C "$clonePath" submodule status --recursive | wc -l | tr -d ' ') submodules"
  echo "$clonePath"
}

eachClone() {
  canonicalPath="$1"
  for candidatePath in "$canonicalPath"-*; do
    [ -f "$candidatePath/.gitto" ] || continue
    [ "$(cat "$candidatePath/.gitto")" = "$canonicalPath" ] || continue
    echo "$candidatePath"
  done
}

describeClone() {
  clonePath="$1"
  currentBranch=$(git -C "$clonePath" symbolic-ref --short -q HEAD || echo DETACHED)
  dirtyCount=$(git -C "$clonePath" status --porcelain | wc -l | tr -d ' ')
  unpushedCount=$(git -C "$clonePath" log --oneline '@{upstream}..HEAD' 2>/dev/null | wc -l | tr -d ' ')
  printf "%-28s %-34s dirty=%-5s unpushed=%s\n" "$(basename "$clonePath")" "$currentBranch" "$dirtyCount" "$unpushedCount"
}

listClones() {
  canonicalPath=$(resolveCanonical)
  echo "canonical $(basename "$canonicalPath")  $(git -C "$canonicalPath" symbolic-ref --short -q HEAD || echo DETACHED)"
  eachClone "$canonicalPath" | while read -r clonePath; do describeClone "$clonePath"; done
}

removeClone() {
  [ $# -ge 1 ] || printUsage
  canonicalPath=$(resolveCanonical)
  clonePath="$canonicalPath-$1"
  [ -f "$clonePath/.gitto" ] || fail "not a gitto: $clonePath"

  dirtyCount=$(git -C "$clonePath" status --porcelain | wc -l | tr -d ' ')
  [ "$dirtyCount" -eq 0 ] || fail "$1 holds $dirtyCount uncommitted changes"
  unpushedCount=$(git -C "$clonePath" log --oneline '@{upstream}..HEAD' 2>/dev/null | wc -l | tr -d ' ')
  [ "$unpushedCount" -eq 0 ] || fail "$1 holds $unpushedCount commits no remote has"

  rm -rf "$clonePath"
  echo "removed $(basename "$clonePath")"
}

diagnoseClone() {
  canonicalPath=$(resolveCanonical)
  if [ $# -ge 1 ]; then
    inspectedPaths="$canonicalPath-$1"
  else
    inspectedPaths=$(eachClone "$canonicalPath")
  fi
  [ -n "$inspectedPaths" ] || { echo "no clones"; return; }
  echo "$inspectedPaths" | while read -r clonePath; do
    echo "$(basename "$clonePath")"
    findings=$(reportCanonicalReferences "$clonePath" "$canonicalPath")
    [ -n "$findings" ] && echo "$findings" || echo "  nothing points at the canonical"
  done
}

[ $# -ge 1 ] || printUsage
command="$1"
shift
case "$command" in
  new) createClone "$@" ;;
  list) listClones ;;
  remove) removeClone "$@" ;;
  doctor) diagnoseClone "$@" ;;
  *) printUsage ;;
esac
