#!/bin/sh
set -eu

gittoVersion=0.4.0

updateInstalledScript() {
  runningScript=$0
  case $runningScript in
    */*) ;;
    *) runningScript=$(command -v "$runningScript") ;;
  esac
  [ -f "$runningScript" ] || fail "cannot find the script this command is running from"

  if [ -L "$runningScript" ]; then
    fail "$runningScript is a symbolic link into a checkout, so it already follows
      whatever that checkout holds. Update it with git there instead."
  fi

  downloadPath="$runningScript.gitto-downloading"
  sourceUrl=${GITTO_SOURCE_URL:-https://gitto.13e7.co/gitto}
  curl -fsSL "$sourceUrl" -o "$downloadPath" 2>/dev/null || {
    rm -f "$downloadPath"
    fail "could not read $sourceUrl"
  }
  sh -n "$downloadPath" 2>/dev/null || {
    rm -f "$downloadPath"
    fail "what $sourceUrl served does not parse, so nothing was replaced"
  }
  chmod +x "$downloadPath"
  fetchedVersion=$(sh "$downloadPath" version 2>/dev/null | sed 's/^gitto //')
  mv "$downloadPath" "$runningScript"

  if [ "$gittoVersion" = "$fetchedVersion" ]; then
    echo "gitto $gittoVersion is already what $sourceUrl serves"
  else
    echo "gitto $gittoVersion -> $fetchedVersion at $runningScript"
  fi
}


printUsage() {
  cat >&2 <<'USAGE'
usage: gitto <command> [arguments]

  gitto new <name> [<base>]   make a clone of the canonical checkout
      --branch <branch>       name the branch, when it differs from <name>
  gitto list [--json]         show every clone beside the canonical
  gitto remove <name>         remove a clone holding nothing unpushed
  gitto prune [--remove]      list clones whose work is merged, or remove them
  gitto doctor [<name>]       report references pointing outside a clone
  gitto sync                  bring the canonical up to date
  gitto path <name>           print where a clone lives
  gitto adopt <canonical>     point this clone at a canonical that moved
  gitto shell-init            emit the shell function and completions
  gitto update                replace this script with what the site serves
  gitto version               print the version

A clone carries the whole checkout: history, submodules, dependencies, build
output and local files. It shares its blocks with the canonical until either
side writes. Run from the canonical checkout, or from any clone of it.
USAGE
  exit 2
}

cloneUnderConstruction=""

removePartialClone() {
  [ -n "$cloneUnderConstruction" ] || return 0
  partialPath="$cloneUnderConstruction"
  cloneUnderConstruction=""
  rm -rf "$partialPath"
  echo "gitto: removed the partial clone $(basename "$partialPath")" >&2
}

fail() {
  echo "gitto: $1" >&2
  removePartialClone
  exit 1
}

readFlag() {
  flagName="$1"
  shift
  for argument in "$@"; do
    [ "$argument" = "$flagName" ] && { echo yes; return; }
  done
  echo no
}

withoutFlags() {
  for argument in "$@"; do
    case "$argument" in --*) ;; *) printf '%s\n' "$argument" ;; esac
  done
}

jsonString() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

absolutePathOf() {
  (cd "$1" && pwd -P)
}

physicalPathOf() {
  candidatePath="$1"
  candidateParent=$(dirname "$candidatePath")
  [ -d "$candidateParent" ] || { echo "$candidatePath"; return; }
  echo "$(cd "$candidateParent" && pwd -P)/$(basename "$candidatePath")"
}

repositoryRootOf() {
  git -C "$1" rev-parse --show-toplevel 2>/dev/null
}

resolveCanonical() {
  repositoryRoot=$(repositoryRootOf "$PWD") || fail "not inside a git repository"
  if [ -f "$repositoryRoot/.gitto" ]; then
    recordedCanonical=$(cat "$repositoryRoot/.gitto")
    [ -d "$recordedCanonical" ] || fail "this clone records a canonical that is gone: $recordedCanonical"
    echo "$recordedCanonical"
    return
  fi
  echo "$repositoryRoot"
}

requireIndependentCheckout() {
  checkoutPath="$1"
  [ -d "$checkoutPath/.git" ] && return 0
  fail "the canonical is a git worktree, whose history lives elsewhere: $checkoutPath
      a clone is made from a real clone. run 'git clone' once and use that as the canonical."
}

probeSizeInMegabytes=32
probeSizeInKilobytes=$((probeSizeInMegabytes * 1024))

freeKilobytesIn() {
  df -k "$1" | awk 'NR == 2 { print $4 }'
}

copyCostsNothing() {
  cloneKind="$1"
  probeSource="$2"
  probeTarget="$3"
  probeDirectory="$4"
  rm -f "$probeTarget"
  freeKilobytesBefore=$(freeKilobytesIn "$probeDirectory")
  case "$cloneKind" in
    clonefile) /bin/cp -c "$probeSource" "$probeTarget" 2>/dev/null || return 1 ;;
    reflink) cp --reflink=always "$probeSource" "$probeTarget" 2>/dev/null || return 1 ;;
  esac
  freeKilobytesAfter=$(freeKilobytesIn "$probeDirectory")
  [ $((freeKilobytesBefore - freeKilobytesAfter)) -lt $((probeSizeInKilobytes / 4)) ]
}

resolveCloneCommand() {
  probeDirectory="$1"
  probeSource="$probeDirectory/.gitto-probe.$$"
  probeTarget="$probeDirectory/.gitto-probe.$$.copy"
  dd if=/dev/urandom of="$probeSource" bs=1048576 count="$probeSizeInMegabytes" 2>/dev/null
  for cloneKind in clonefile reflink; do
    if copyCostsNothing "$cloneKind" "$probeSource" "$probeTarget" "$probeDirectory"; then
      rm -f "$probeSource" "$probeTarget"
      echo "$cloneKind"
      return 0
    fi
  done
  rm -f "$probeSource" "$probeTarget"
  fail "copying here costs the full size, so a clone would too.
      macOS needs APFS; Linux needs btrfs, XFS with reflink=1, or OpenZFS 2.2+.
      ext4 and tmpfs cannot share blocks at all."
}

copyTreeCheaply() {
  cloneKind="$1"
  sourcePath="$2"
  destinationPath="$3"
  cloneErrors=$(mktemp)
  case "$cloneKind" in
    clonefile) /bin/cp -c -R "$sourcePath" "$destinationPath" 2>"$cloneErrors" || true ;;
    reflink) cp --reflink=always -a "$sourcePath" "$destinationPath" 2>"$cloneErrors" || true ;;
  esac
  unexplainedErrors=$(grep -v 'is a socket (not copied)' "$cloneErrors" || true)
  rm -f "$cloneErrors"
  [ -z "$unexplainedErrors" ] || fail "clone reported more than skipped sockets:
$unexplainedErrors"
  [ -d "$destinationPath/.git" ] || fail "clone produced no history at $destinationPath"
}

detachInheritedWorktrees() {
  clonePath="$1"
  detachedCount=$(( $(git -C "$clonePath" worktree list | wc -l | tr -d ' ') - 1 ))
  rm -rf "$clonePath/.git/worktrees"
  git -C "$clonePath" worktree prune

  for registrationDirectory in $(find "$clonePath/.git/modules" -type d -name worktrees 2>/dev/null); do
    detachedCount=$(( detachedCount + $(ls -A "$registrationDirectory" | wc -l | tr -d ' ') ))
    rm -rf "$registrationDirectory"
  done

  [ "$detachedCount" -gt 0 ] || return 0
  echo "  detached $detachedCount inherited worktree registrations"
}

repointCanonicalReferences() {
  clonePath="$1"
  canonicalPath="$2"
  configuredHooksPath=$(git -C "$clonePath" config --local --get core.hooksPath || true)
  [ -n "$configuredHooksPath" ] || return 0
  resolvedHooksPath=$(physicalPathOf "$configuredHooksPath")
  case "$resolvedHooksPath" in
    "$canonicalPath"/*)
      relocatedHooksPath="$clonePath${resolvedHooksPath#"$canonicalPath"}"
      git -C "$clonePath" config --local core.hooksPath "$relocatedHooksPath"
      echo "  repointed core.hooksPath at this clone's own hooks"
      ;;
  esac
}

namesThisPathOutsideGit() {
  inspectedPath="$1"
  for settingsFile in "$HOME/.ssh/config" "$HOME/.gitconfig" /etc/fstab; do
    [ -f "$settingsFile" ] || continue
    grep -qF "$inspectedPath" "$settingsFile" 2>/dev/null &&
      echo "  outside git  $settingsFile names this path"
  done
  for settingsDirectory in \
    "$HOME/Library/LaunchAgents" /Library/LaunchDaemons \
    /etc/systemd/system "$HOME/.config/systemd/user"
  do
    [ -d "$settingsDirectory" ] || continue
    grep -rlF "$inspectedPath" "$settingsDirectory" 2>/dev/null |
      while read -r namingFile; do
        [ -n "$namingFile" ] && echo "  outside git  $namingFile names this path"
      done
  done
  crontab -l 2>/dev/null | grep -qF "$inspectedPath" &&
    echo "  outside git  your crontab names this path"
  return 0
}

reportCanonicalReferences() {
  clonePath="$1"
  canonicalPath="$2"
  canonicalPrefix="$canonicalPath/"
  remainingReferences=$(
    {
      git -C "$clonePath" config --local --list | grep -F "$canonicalPrefix" | sed 's/^/  git config   /' || true
      find "$clonePath" -maxdepth 4 -type l -not -path '*/.git/*' -not -path '*/node_modules/*' \
        -exec sh -c 'prefix=$1; shift; for link; do
            target=$(readlink "$link")
            case $target in /*) ;; *) target="$(dirname "$link")/$target" ;; esac
            parent=$(dirname "$target")
            [ -d "$parent" ] && target="$(cd "$parent" && pwd -P)/$(basename "$target")"
            case $target in "$prefix"*) echo "  symlink      $link -> $target" ;; esac
          done' _ "$canonicalPrefix" {} + 2>/dev/null || true
      for activationScript in "$clonePath"/*/bin/activate "$clonePath"/.venv/bin/activate "$clonePath"/venv/bin/activate; do
        [ -f "$activationScript" ] || continue
        if grep -qF "$canonicalPrefix" "$activationScript"; then
          echo "  virtualenv   $activationScript"
        fi
      done
      reportHostedWorktrees "$clonePath"
      git -C "$clonePath" submodule foreach --recursive --quiet \
        'git rev-parse --absolute-git-dir' 2>/dev/null \
        | while read -r submoduleGitDirectory; do
            if [ "${submoduleGitDirectory#"$clonePath"/}" = "$submoduleGitDirectory" ]; then
              echo "  submodule    history outside this clone: $submoduleGitDirectory"
            fi
          done
        namesThisPathOutsideGit "$clonePath"
    } 2>/dev/null
  )
  [ -n "$remainingReferences" ] || return 0
  echo "  still pointing outside this clone:"
  echo "$remainingReferences"
}

nestedWorktreesOf() {
  checkoutPath="$1"
  git -C "$checkoutPath" worktree list --porcelain \
    | sed -n 's/^worktree //p' \
    | while read -r worktreePath; do
        relativePath="${worktreePath#"$checkoutPath"/}"
        if [ "$relativePath" != "$worktreePath" ]; then
          echo "$relativePath"
        fi
      done
}

dropNestedWorktrees() {
  clonePath="$1"
  nestedWorktrees="$2"
  [ -n "$nestedWorktrees" ] || return 0
  echo "$nestedWorktrees" | while read -r relativePath; do
    [ -n "$relativePath" ] || continue
    rm -rf "$clonePath/$relativePath"
  done
  echo "  dropped $(echo "$nestedWorktrees" | wc -l | tr -d ' ') worktrees the canonical keeps inside itself"
}

excludeCloneMarker() {
  clonePath="$1"
  grep -qxF '/.gitto' "$clonePath/.git/info/exclude" 2>/dev/null && return 0
  echo '/.gitto' >> "$clonePath/.git/info/exclude"
}

reportCarriedChanges() {
  clonePath="$1"
  canonicalPath="$2"
  baseRevision="$3"
  carriedCommits=$(git -C "$clonePath" log --oneline "$baseRevision..HEAD" 2>/dev/null | wc -l | tr -d ' ')
  carriedChanges=$(git -C "$clonePath" status --porcelain | wc -l | tr -d ' ')
  [ "$carriedCommits" = 0 ] && [ "$carriedChanges" = 0 ] && return 0
  echo "  carried from the canonical: $carriedCommits commits, $carriedChanges uncommitted files"
  echo "  they are this clone's copies; the canonical keeps its own"
}

createClone() {
  branchName=""
  positional=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch) branchName="${2:-}"; shift 2 ;;
      --branch=*) branchName="${1#--branch=}"; shift ;;
      *) positional="$positional $1"; shift ;;
    esac
  done
  # shellcheck disable=SC2086
  set -- $positional
  [ $# -ge 1 ] || printUsage
  cloneName="$1"
  requestedBase="${2:-}"
  [ -n "$branchName" ] || branchName="$cloneName"

  canonicalPath=$(resolveCanonical)
  requireIndependentCheckout "$canonicalPath"
  clonePath="$canonicalPath-$cloneName"
  [ -e "$clonePath" ] && fail "already exists: $clonePath"

  cloneKind=$(resolveCloneCommand "$(dirname "$canonicalPath")")
  nestedWorktrees=$(nestedWorktreesOf "$canonicalPath")
  baseRevision=${requestedBase:-$(git -C "$canonicalPath" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)}

  echo "cloning $(basename "$canonicalPath") -> $(basename "$clonePath") by $cloneKind"
  trap 'removePartialClone' EXIT INT TERM
  cloneUnderConstruction="$clonePath"
  freeKilobytesBeforeClone=$(freeKilobytesIn "$(dirname "$canonicalPath")")
  copyTreeCheaply "$cloneKind" "$canonicalPath" "$clonePath"
  freeKilobytesAfterClone=$(freeKilobytesIn "$(dirname "$canonicalPath")")
  echo "$canonicalPath" > "$clonePath/.gitto"

  detachInheritedWorktrees "$clonePath"
  dropNestedWorktrees "$clonePath" "$nestedWorktrees"
  repointCanonicalReferences "$clonePath" "$canonicalPath"

  excludeCloneMarker "$clonePath"
  if git -C "$clonePath" remote get-url origin >/dev/null 2>&1; then
    git -C "$clonePath" fetch --quiet origin
  elif [ -z "$requestedBase" ]; then
    fail "this checkout has no origin, so there is no default base to start from.
      name the revision you want, such as the canonical as it stands:
        gitto new $cloneName HEAD"
  fi
  git -C "$clonePath" checkout --quiet -B "$branchName" "$baseRevision" \
    || fail "the canonical holds changes that collide with $baseRevision.
      commit or drop them there, or make the clone at the canonical's own
      revision, which carries everything as it stands:
        gitto new $cloneName HEAD"
  if [ "$requestedBase" = HEAD ]; then
    echo "  submodules left as the canonical had them"
  else
    git -C "$clonePath" submodule update --quiet --init --recursive
  fi

  clonedKilobytes=$((freeKilobytesBeforeClone - freeKilobytesAfterClone))
  [ "$clonedKilobytes" -ge 0 ] || clonedKilobytes=0
  git -C "$clonePath" config --local gitto.diskKilobytes "$clonedKilobytes"

  cloneUnderConstruction=""
  trap - EXIT INT TERM
  reportCarriedChanges "$clonePath" "$canonicalPath" "$baseRevision"
  reportCanonicalReferences "$clonePath" "$canonicalPath" || true
  echo "  branch $branchName on $baseRevision, $(git -C "$clonePath" submodule status --recursive | wc -l | tr -d ' ') submodules, $(humanKilobytes "$clonedKilobytes") of disk"
  echo "$clonePath"
}

humanKilobytes() {
  kilobytes="$1"
  if [ "$kilobytes" -ge 1048576 ]; then
    echo "$((kilobytes / 1048576)) GB"
  elif [ "$kilobytes" -ge 1024 ]; then
    echo "$((kilobytes / 1024)) MB"
  else
    echo "$kilobytes KB"
  fi
}

eachClone() {
  canonicalPath="$1"
  for candidatePath in "$canonicalPath"-*; do
    [ -f "$candidatePath/.gitto" ] || continue
    [ "$(cat "$candidatePath/.gitto")" = "$canonicalPath" ] || continue
    echo "$candidatePath"
  done
}

branchOf() {
  git -C "$1" symbolic-ref --short -q HEAD || echo DETACHED
}

dirtyCountOf() {
  git -C "$1" status --porcelain | wc -l | tr -d ' '
}

unpushedCountOf() {
  git -C "$1" log --oneline '@{upstream}..HEAD' 2>/dev/null | wc -l | tr -d ' '
}

diskKilobytesOf() {
  git -C "$1" config --local --get gitto.diskKilobytes 2>/dev/null || echo ""
}

behindCountOf() {
  git -C "$1" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || echo 0
}

describeCanonical() {
  canonicalPath="$1"
  behindCount=$(behindCountOf "$canonicalPath")
  staleness=""
  [ "$behindCount" -gt 0 ] && staleness="  $behindCount behind $(git -C "$canonicalPath" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo upstream)"
  echo "canonical $(basename "$canonicalPath")  $(branchOf "$canonicalPath")$staleness"
  [ "$behindCount" -gt 0 ] && echo "  every clone starts from what the canonical holds; 'gitto sync' updates it"
  return 0
}

describeClone() {
  clonePath="$1"
  diskKilobytes=$(diskKilobytesOf "$clonePath")
  [ -n "$diskKilobytes" ] && diskColumn=$(humanKilobytes "$diskKilobytes") || diskColumn="?"
  printf "%-24s %-22s dirty=%-5s unpushed=%-5s %s\n" \
    "$(basename "$clonePath")" "$(branchOf "$clonePath")" \
    "$(dirtyCountOf "$clonePath")" "$(unpushedCountOf "$clonePath")" "$diskColumn"
}

shortNameOf() {
  clonePath="$1"
  canonicalPath="$2"
  echo "${clonePath#"$canonicalPath"-}"
}

describeCloneAsJson() {
  clonePath="$1"
  canonicalPath="$2"
  diskKilobytes=$(diskKilobytesOf "$clonePath")
  printf '    {"name": "%s", "directory": "%s", "path": "%s", "branch": "%s", "dirty": %s, "unpushed": %s, "diskKilobytes": %s}' \
    "$(jsonString "$(shortNameOf "$clonePath" "$canonicalPath")")" \
    "$(jsonString "$(basename "$clonePath")")" "$(jsonString "$clonePath")" \
    "$(jsonString "$(branchOf "$clonePath")")" "$(dirtyCountOf "$clonePath")" \
    "$(unpushedCountOf "$clonePath")" "${diskKilobytes:-null}"
}

listClones() {
  canonicalPath=$(resolveCanonical)
  if [ "$(readFlag --json "$@")" = no ]; then
    describeCanonical "$canonicalPath"
    eachClone "$canonicalPath" | while read -r clonePath; do describeClone "$clonePath"; done
    return 0
  fi
  printf '{\n  "canonical": {"name": "%s", "path": "%s", "branch": "%s", "behind": %s},\n  "clones": [\n' \
    "$(jsonString "$(basename "$canonicalPath")")" "$(jsonString "$canonicalPath")" \
    "$(jsonString "$(branchOf "$canonicalPath")")" "$(behindCountOf "$canonicalPath")"
  separator=""
  eachClone "$canonicalPath" | while read -r clonePath; do
    printf '%b' "$separator"
    describeCloneAsJson "$clonePath" "$canonicalPath"
    separator=",\n"
    printf '\n'
  done
  printf '  ]\n}\n'
}

worktreesHostedOutside() {
  hostPath="$1"
  {
    git -C "$hostPath" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p'
    git -C "$hostPath" submodule foreach --recursive --quiet \
      'git worktree list --porcelain' 2>/dev/null | sed -n 's/^worktree //p'
  } | while read -r hostedPath; do
      if [ "${hostedPath#"$hostPath"}" = "$hostedPath" ]; then
        echo "$hostedPath"
      fi
    done
}

markerTargetOf() {
  worktreePath="$1"
  [ -f "$worktreePath/.git" ] || return 1
  sed -n 's/^gitdir: //p' "$worktreePath/.git" | head -1
}

reportHostedWorktrees() {
  hostPath="$1"
  worktreesHostedOutside "$hostPath" | while read -r hostedPath; do
    if [ ! -d "$hostedPath" ]; then
      echo "  hosts        $hostedPath (registered, but nothing is there)"
      continue
    fi
    if [ -d "$hostedPath/.git" ]; then
      echo "  hosts        $hostedPath (registered, but it carries its own repository now)"
      continue
    fi
    markerTarget=$(markerTargetOf "$hostedPath") || {
      echo "  hosts        $hostedPath (registered, but it has no gitdir marker)"
      continue
    }
    if [ ! -d "$markerTarget" ]; then
      echo "  hosts        $hostedPath (its marker points at $markerTarget, which is gone)"
    elif [ "${markerTarget#"$hostPath"/}" = "$markerTarget" ]; then
      echo "  hosts        $hostedPath (its marker points into $markerTarget, which is not this checkout)"
    else
      echo "  hosts        $hostedPath"
    fi
  done
}

removeClone() {
  [ $# -ge 1 ] || printUsage
  canonicalPath=$(resolveCanonical)
  clonePath="$canonicalPath-$1"
  [ -f "$clonePath/.gitto" ] || fail "not a gitto: $clonePath"

  dirtyCount=$(git -C "$clonePath" status --porcelain | wc -l | tr -d ' ')
  [ "$dirtyCount" -eq 0 ] || fail "$1 holds $dirtyCount uncommitted changes"
  unpushedCount=$(git -C "$clonePath" log --oneline '@{upstream}..HEAD' 2>/dev/null | wc -l | tr -d ' ')
  [ "$unpushedCount" -eq 0 ] || fail "$1 holds $unpushedCount commits no remote has"
  hostedElsewhere=$(worktreesHostedOutside "$clonePath")
  [ -z "$hostedElsewhere" ] || fail "$1 hosts the history of worktrees that live outside it:
$(echo "$hostedElsewhere" | sed 's/^/        /')
      removing it would leave each of them without a repository."

  rm -rf "$clonePath"
  echo "removed $(basename "$clonePath")"
}

diagnoseClone() {
  canonicalPath=$(resolveCanonical)
  if [ $# -ge 1 ]; then
    inspectedPaths="$canonicalPath-$1"
  else
    inspectedPaths=$(eachClone "$canonicalPath")
    echo "$(basename "$canonicalPath")  canonical"
    hostedFindings=$(reportHostedWorktrees "$canonicalPath")
    if [ -n "$hostedFindings" ]; then
      echo "$hostedFindings"
    else
      echo "  it hosts no worktree that lives outside it"
    fi
  fi
  [ -n "$inspectedPaths" ] || { echo "no clones"; return; }
  echo "$inspectedPaths" | while read -r clonePath; do
    echo "$(basename "$clonePath")"
    findings=$(reportCanonicalReferences "$clonePath" "$canonicalPath" || true)
    if [ -n "$findings" ]; then
      echo "$findings"
    else
      echo "  nothing git can see points at the canonical"
    fi
  done
}

mergedIntoUpstream() {
  clonePath="$1"
  canonicalPath="$2"
  mergeTarget=$(git -C "$canonicalPath" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
  git -C "$clonePath" merge-base --is-ancestor HEAD "$mergeTarget" 2>/dev/null
}

pruneClones() {
  canonicalPath=$(resolveCanonical)
  removing=$(readFlag --remove "$@")
  found=no
  for clonePath in $(eachClone "$canonicalPath"); do
    [ "$(dirtyCountOf "$clonePath")" -eq 0 ] || continue
    [ "$(unpushedCountOf "$clonePath")" -eq 0 ] || continue
    [ -z "$(worktreesHostedOutside "$clonePath")" ] || continue
    mergedIntoUpstream "$clonePath" "$canonicalPath" || continue
    found=yes
    if [ "$removing" = yes ]; then
      rm -rf "$clonePath"
      echo "removed $(basename "$clonePath")"
    else
      echo "$(basename "$clonePath")  $(branchOf "$clonePath")  merged, nothing to lose"
    fi
  done
  [ "$found" = yes ] || { echo "nothing to prune"; return 0; }
  [ "$removing" = yes ] || echo "run 'gitto prune --remove' to delete these"
}

syncCanonical() {
  canonicalPath=$(resolveCanonical)
  requireIndependentCheckout "$canonicalPath"
  git -C "$canonicalPath" fetch --quiet origin || fail "the canonical has no origin to fetch from"
  behindCount=$(behindCountOf "$canonicalPath")
  if [ "$behindCount" -eq 0 ]; then
    echo "canonical $(basename "$canonicalPath") is up to date"
  else
    git -C "$canonicalPath" merge --ff-only --quiet '@{upstream}' \
      || fail "the canonical cannot move $behindCount commits forward.
      it holds commits its upstream does not, or local changes the move would
      overwrite. git said why just above."
    git -C "$canonicalPath" submodule update --quiet --init --recursive
    echo "canonical $(basename "$canonicalPath") moved $behindCount commits forward"
  fi
  [ -f "$canonicalPath/.gitto-refresh" ] || {
    echo "  a .gitto-refresh script in the canonical would rebuild what a clone inherits"
    return 0
  }
  echo "  running .gitto-refresh"
  ( cd "$canonicalPath" && sh .gitto-refresh ) || fail ".gitto-refresh failed, so the canonical is not ready to clone from"
}

printClonePath() {
  [ $# -ge 1 ] || printUsage
  canonicalPath=$(resolveCanonical)
  clonePath="$canonicalPath-$1"
  [ -f "$clonePath/.gitto" ] || fail "not a gitto: $clonePath"
  echo "$clonePath"
}

statusEverywhere() {
  repositoryPath="$1"
  git -C "$repositoryPath" status --porcelain 2>/dev/null
  git -C "$repositoryPath" submodule foreach --recursive --quiet \
    'git status --porcelain | sed "s|^|$displaypath |"' 2>/dev/null || true
}

recordSubmoduleHeads() {
  repositoryPath="$1"
  git -C "$repositoryPath" submodule foreach --recursive --quiet \
    'printf "%s\n%s\n%s\n%s\n%s\n" "$displaypath" "$(git rev-parse HEAD)" \
      "$(git rev-parse --abbrev-ref HEAD)" "$(git rev-parse --absolute-git-dir)" "$(cat .git 2>/dev/null)"' \
    2>/dev/null || true
}

discardAdoptionScaffolding() {
  repositoryPath="$1"
  git -C "$repositoryPath" for-each-ref --format='%(refname)' 'refs/gitto-adopted' 2>/dev/null |
    while read -r scaffoldRef; do
      [ -n "$scaffoldRef" ] || continue
      git -C "$repositoryPath" update-ref -d "$scaffoldRef" </dev/null
    done
  git -C "$repositoryPath" submodule foreach --recursive --quiet \
    'git for-each-ref --format="%(refname)" "refs/gitto-adopted" | while read -r stale; do [ -n "$stale" ] && git update-ref -d "$stale"; done' \
    >/dev/null 2>&1 || true
}

restoreHeadWithoutTouchingFiles() {
  repositoryPath="$1"
  recordedCommit="$2"
  recordedBranch="$3"
  if [ -n "$recordedBranch" ] && [ "$recordedBranch" != HEAD ]; then
    git -C "$repositoryPath" update-ref "refs/heads/$recordedBranch" "$recordedCommit"
    git -C "$repositoryPath" symbolic-ref HEAD "refs/heads/$recordedBranch"
  else
    git -C "$repositoryPath" update-ref --no-deref HEAD "$recordedCommit"
  fi
  git -C "$repositoryPath" read-tree "$recordedCommit"
  git -C "$repositoryPath" update-index --refresh >/dev/null 2>&1 || true
}

copyGitDirectory() {
  sourceGitDirectory="$1"
  destinationGitDirectory="$2"
  copyErrors=$(mktemp)
  case "$(resolveCloneCommand "$(dirname "$destinationGitDirectory")")" in
    clonefile) /bin/cp -c -R "$sourceGitDirectory" "$destinationGitDirectory" 2>"$copyErrors" || true ;;
    reflink) cp --reflink=always -a "$sourceGitDirectory" "$destinationGitDirectory" 2>"$copyErrors" || true ;;
  esac
  unexplainedErrors=$(grep -v 'is a socket (not copied)' "$copyErrors" || true)
  rm -f "$copyErrors"
  [ -z "$unexplainedErrors" ] || fail "copying history reported more than skipped sockets:
  $unexplainedErrors"
  [ -f "$destinationGitDirectory/HEAD" ] || fail "copying history produced nothing at $destinationGitDirectory"
}

adoptCanonical() {
  [ $# -ge 1 ] || printUsage
  newCanonical=$(absolutePathOf "$1") || fail "no such directory: $1"
  [ -d "$newCanonical/.git" ] || fail "that is not an independent checkout: $newCanonical"
  repositoryRoot=$(repositoryRootOf "$PWD") || fail "not inside a git repository"

  if [ -f "$repositoryRoot/.gitto" ]; then
    echo "$newCanonical" > "$repositoryRoot/.gitto"
    echo "$(basename "$repositoryRoot") now follows $(basename "$newCanonical")"
    return 0
  fi

  [ -f "$repositoryRoot/.git" ] \
    || fail "$(basename "$repositoryRoot") is already an independent checkout, so it has no worktree to convert and no canonical to follow"
  adoptWorktree "$repositoryRoot" "$newCanonical"
}

adoptWorktree() {
  targetPath="$1"
  canonicalPath="$2"
  [ "$targetPath" != "$canonicalPath" ] || fail "a canonical cannot adopt itself"

  hostGitDirectory=$(git -C "$targetPath" rev-parse --absolute-git-dir)
  hostCommonDirectory=$(cd "$(git -C "$targetPath" rev-parse --git-common-dir)" && pwd -P)
  hostPath=$(dirname "$hostCommonDirectory")

  branchName=$(git -C "$targetPath" rev-parse --abbrev-ref HEAD)
  headCommit=$(git -C "$targetPath" rev-parse HEAD)
  recordedState=$(statusEverywhere "$targetPath")
  adoptionRecordFile=$(mktemp)
  recordSubmoduleHeads "$targetPath" > "$adoptionRecordFile"
  submoduleCount=$(( $(wc -l < "$adoptionRecordFile") / 5 ))
  adoptionSavedMarker=$(cat "$targetPath/.git")

  echo "adopting $(basename "$targetPath") from $(basename "$hostPath") into $(basename "$canonicalPath")"

  stagedGitDirectory="$targetPath/.git.gitto-adopting"
  [ -e "$stagedGitDirectory" ] && fail "something is already at $stagedGitDirectory"
  freeKilobytesBeforeCopy=$(freeKilobytesIn "$targetPath")
  copyGitDirectory "$canonicalPath/.git" "$stagedGitDirectory"
  freeKilobytesAfterCopy=$(freeKilobytesIn "$targetPath")
  rm -rf "$stagedGitDirectory/worktrees"
  git --git-dir="$stagedGitDirectory" config --unset core.worktree 2>/dev/null || true
  git --git-dir="$stagedGitDirectory" config core.bare false

  rm -f "$targetPath/.git"
  mv "$stagedGitDirectory" "$targetPath/.git"
  adoptionUnderway="$targetPath"
  trap 'abandonAdoption' EXIT INT TERM

  git -C "$targetPath" fetch --quiet "$hostPath" '+refs/heads/*:refs/gitto-adopted/*' 2>/dev/null || true
  restoreHeadWithoutTouchingFiles "$targetPath" "$headCommit" "$branchName"

  while read -r submodulePath; do
    read -r submoduleCommit || break
    read -r submoduleBranch || break
    read -r submoduleGitDirectory || break
    read -r originalMarker || break
    [ -n "$submodulePath" ] || continue
    [ -f "$targetPath/$submodulePath/.git" ] || continue
    printf 'gitdir: %s\n' "$targetPath/.git${submoduleGitDirectory#"$hostGitDirectory"}" \
      > "$targetPath/$submodulePath/.git"
    git -C "$targetPath/$submodulePath" fetch --quiet "$submoduleGitDirectory" \
      '+refs/heads/*:refs/gitto-adopted/*' </dev/null 2>/dev/null || true
    restoreHeadWithoutTouchingFiles "$targetPath/$submodulePath" "$submoduleCommit" "$submoduleBranch" </dev/null
  done < "$adoptionRecordFile"

  currentState=$(statusEverywhere "$targetPath")
  [ "$currentState" = "$recordedState" ] || fail "the working tree reads differently than it did before, so nothing was kept:
  was: $(printf '%s' "$recordedState" | tr '\n' '|')
  now: $(printf '%s' "$currentState" | tr '\n' '|')"

  adoptionUnderway=""
  trap - EXIT INT TERM

  rm -rf "$hostGitDirectory"
  git -C "$hostPath" worktree prune
  repointCanonicalReferences "$targetPath" "$canonicalPath"
  echo "$canonicalPath" > "$targetPath/.gitto"
  excludeCloneMarker "$targetPath"
  discardAdoptionScaffolding "$targetPath"
  adoptedKilobytes=$((freeKilobytesBeforeCopy - freeKilobytesAfterCopy))
  [ "$adoptedKilobytes" -ge 0 ] || adoptedKilobytes=0
  git -C "$targetPath" config --local gitto.diskKilobytes "$adoptedKilobytes"
  rm -f "$adoptionRecordFile"

  echo "  history now lives in $(basename "$targetPath")/.git, copied from the canonical"
  echo "  $(basename "$hostPath") no longer registers it as a worktree"
  echo "  branch $branchName, $submoduleCount submodules, nothing moved"
  echo "  $(humanKilobytes "$adoptedKilobytes") of disk, since only the history was copied"
}

abandonAdoption() {
  [ -n "${adoptionUnderway:-}" ] || return 0
  echo "gitto: restoring $(basename "$adoptionUnderway") as a worktree" >&2
  rm -rf "$adoptionUnderway/.git"
  printf '%s\n' "$adoptionSavedMarker" > "$adoptionUnderway/.git"
  [ -f "${adoptionRecordFile:-}" ] && while read -r submodulePath; do
    read -r ignoredCommit || break
    read -r ignoredBranch || break
    read -r ignoredGitDirectory || break
    read -r originalMarker || break
    [ -n "$submodulePath" ] || continue
    [ -f "$adoptionUnderway/$submodulePath/.git" ] || continue
    printf '%s\n' "$originalMarker" > "$adoptionUnderway/$submodulePath/.git"
  done < "$adoptionRecordFile"
  adoptionUnderway=""
}

printShellInit() {
  cat <<'INIT'
gitto() {
  case "${1:-}" in
    new)
      gittoOutput=$(command gitto "$@") || { printf '%s\n' "$gittoOutput" >&2; return 1; }
      printf '%s\n' "$gittoOutput"
      cd "$(printf '%s\n' "$gittoOutput" | tail -1)" || return
      ;;
    cd)
      [ -n "${2:-}" ] || { command gitto list; return; }
      cd "$(command gitto path "$2")" || return
      ;;
    *) command gitto "$@" ;;
  esac
}

_gittoCloneNames() {
  command gitto list --json 2>/dev/null | sed -n 's/.*"name": "\([^"]*\)".*/\1/p'
}

_gittoCommands='new list remove prune doctor sync path adopt shell-init update version'

if [ -n "${ZSH_VERSION:-}" ]; then
  _gitto() {
    if (( CURRENT == 2 )); then
      compadd -- ${=_gittoCommands}
    else
      case "${words[2]}" in
        remove|doctor|path|cd) compadd -- $(_gittoCloneNames) ;;
      esac
    fi
  }
  compdef _gitto gitto
elif [ -n "${BASH_VERSION:-}" ]; then
  _gitto() {
    if [ "$COMP_CWORD" -eq 1 ]; then
      COMPREPLY=($(compgen -W "$_gittoCommands" -- "${COMP_WORDS[COMP_CWORD]}"))
    else
      case "${COMP_WORDS[1]}" in
        remove|doctor|path|cd) COMPREPLY=($(compgen -W "$(_gittoCloneNames)" -- "${COMP_WORDS[COMP_CWORD]}")) ;;
      esac
    fi
  }
  complete -F _gitto gitto
fi
INIT
}

[ $# -ge 1 ] || printUsage
command="$1"
shift
case "$command" in
  new) createClone "$@" ;;
  list) listClones "$@" ;;
  remove) removeClone "$@" ;;
  prune) pruneClones "$@" ;;
  doctor) diagnoseClone "$@" ;;
  sync) syncCanonical ;;
  path) printClonePath "$@" ;;
  adopt) adoptCanonical "$@" ;;
  shell-init) printShellInit ;;
  update) updateInstalledScript ;;
  version) echo "gitto $gittoVersion" ;;
  *) printUsage ;;
esac
