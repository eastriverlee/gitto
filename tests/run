#!/bin/sh
set -eu

gitto=${GITTO:-$(cd "$(dirname "$0")/.." && pwd)/plugins/gitto/skills/gitto/scripts/gitto}
laboratory=$(mktemp -d)
mkdir -p "$laboratory/empty-home"
passed=0
failed=0

trap 'rm -rf "$laboratory"' EXIT

report() {
  outcome="$1"
  description="$2"
  detail="${3:-}"
  if [ "$outcome" = pass ]; then
    passed=$((passed + 1))
    printf '  ok    %s\n' "$description"
  else
    failed=$((failed + 1))
    printf '  FAIL  %s\n' "$description"
    [ -z "$detail" ] || printf '%s\n' "$detail" | sed 's/^/          /'
  fi
}

expectContains() {
  description="$1"
  haystack="$2"
  needle="$3"
  case "$haystack" in
    *"$needle"*) report pass "$description" ;;
    *) report fail "$description" "wanted: $needle
got: $haystack" ;;
  esac
}

expectEqual() {
  description="$1"
  wanted="$2"
  got="$3"
  if [ "$wanted" = "$got" ]; then
    report pass "$description"
  else
    report fail "$description" "wanted: $wanted
got: $got"
  fi
}

expectMissing() {
  description="$1"
  haystack="$2"
  needle="$3"
  case "$haystack" in
    *"$needle"*) report fail "$description" "did not want: $needle
got: $haystack" ;;
    *) report pass "$description" ;;
  esac
}

expectPath() {
  description="$1"
  if [ -e "$2" ]; then report pass "$description"; else report fail "$description" "missing: $2"; fi
}

expectNoPath() {
  description="$1"
  if [ -e "$2" ]; then report fail "$description" "still there: $2"; else report pass "$description"; fi
}

git() {
  command git -c protocol.file.allow=always -c init.defaultBranch=main \
    -c user.email=test@example.com -c user.name=Test -c commit.gpgsign=false "$@"
}

makeRepository() {
  repositoryPath="$1"
  mkdir -p "$repositoryPath"
  git -C "$repositoryPath" init -q
  printf 'one\n' > "$repositoryPath/file.txt"
  git -C "$repositoryPath" add -A
  git -C "$repositoryPath" commit -qm first
}

makeCanonical() {
  laboratoryName="$1"
  root="${2:-$laboratory}/$laboratoryName"
  mkdir -p "$root"
  makeRepository "$root/source"
  git clone -q --bare "$root/source" "$root/origin" 2>/dev/null
  git clone -q "$root/origin" "$root/canonical" 2>/dev/null
  echo "$root/canonical"
}

runIn() {
  checkoutPath="$1"
  shift
  ( cd "$checkoutPath" && "$gitto" "$@" )
}

carriesUntrackedState() {
  canonical=$(makeCanonical carries)
  mkdir -p "$canonical/node_modules"
  printf 'built\n' > "$canonical/node_modules/marker"
  printf 'node_modules/\n' > "$canonical/.gitignore"
  git -C "$canonical" add -A && git -C "$canonical" commit -qm ignore
  git -C "$canonical" push -q origin main
  runIn "$canonical" new lane >/dev/null 2>&1
  expectPath 'a clone carries ignored build state' "$canonical-lane/node_modules/marker"
}

resolvesNestedSubmodules() {
  root="$laboratory/nested"
  mkdir -p "$root"
  makeRepository "$root/deep"
  makeRepository "$root/middle"
  git -C "$root/middle" submodule add -q "$root/deep" vendor/deep
  git -C "$root/middle" commit -qm submodule
  makeRepository "$root/origin"
  git -C "$root/origin" submodule add -q "$root/middle" vendor/middle
  git -C "$root/origin" commit -qm submodule
  git clone -q --recursive "$root/origin" "$root/canonical" 2>/dev/null
  runIn "$root/canonical" new lane >/dev/null 2>&1
  deepGitDirectory=$(git -C "$root/canonical-lane/vendor/middle/vendor/deep" rev-parse --absolute-git-dir)
  expectContains 'a nested submodule resolves inside the clone' "$deepGitDirectory" "$root/canonical-lane/.git"
  diagnosis=$(runIn "$root/canonical" doctor lane 2>&1)
  expectMissing 'and no submodule is reported as escaping' "$diagnosis" 'history outside this clone'
  expectContains 'and doctor still says the clone is clean' "$diagnosis" 'nothing git can see'
  if runIn "$root/canonical" doctor lane >/dev/null 2>&1; then
    report pass 'and doctor exits zero on a healthy clone with submodules'
  else
    report fail 'and doctor exits zero on a healthy clone with submodules' 'exit was non-zero'
  fi
}

repointsHookPath() {
  canonical=$(makeCanonical hooks)
  git -C "$canonical" config core.hooksPath "$canonical/.githooks"
  output=$(runIn "$canonical" new lane 2>&1)
  expectContains 'an absolute hook path is repointed' "$output" 'repointed core.hooksPath'
  configured=$(git -C "$canonical-lane" config --local --get core.hooksPath)
  expectContains 'the repointed path is inside the clone' "$configured" "$canonical-lane"
}

dropsNestedWorktrees() {
  canonical=$(makeCanonical nestedworktree)
  git -C "$canonical" worktree add -q "$canonical/inside/extra" -b extra
  runIn "$canonical" new lane >/dev/null 2>&1
  expectNoPath 'a worktree kept inside the canonical is dropped' "$canonical-lane/inside/extra"
  expectPath 'the canonical keeps its own' "$canonical/inside/extra"
}

refusesToOrphanWorktrees() {
  root="$laboratory/hosting"
  mkdir -p "$root"
  makeRepository "$root/sub"
  makeRepository "$root/origin"
  git -C "$root/origin" submodule add -q "$root/sub" vendor/sub
  git -C "$root/origin" commit -qm submodule
  git clone -q --recursive "$root/origin" "$root/canonical" 2>/dev/null
  runIn "$root/canonical" new lane >/dev/null 2>&1
  git -C "$root/canonical-lane/vendor/sub" worktree add -q "$root/outside" -b outside
  refusal=$( ( cd "$root/canonical" && "$gitto" remove lane 2>&1 ) || true )
  expectContains 'removing a clone that hosts an outside worktree is refused' "$refusal" 'without a repository'
  expectPath 'the clone survives the refusal' "$root/canonical-lane/.gitto"
}

refusesToLoseWork() {
  canonical=$(makeCanonical losing)
  runIn "$canonical" new lane >/dev/null 2>&1
  printf 'edited\n' > "$canonical-lane/file.txt"
  refusal=$( ( cd "$canonical" && "$gitto" remove lane 2>&1 ) || true )
  expectContains 'a dirty clone is not removed' "$refusal" 'uncommitted changes'
  git -C "$canonical-lane" checkout -q -- file.txt
  printf 'new\n' > "$canonical-lane/second.txt"
  git -C "$canonical-lane" add -A && git -C "$canonical-lane" commit -qm second
  refusal=$( ( cd "$canonical" && "$gitto" remove lane 2>&1 ) || true )
  expectContains 'an unpushed clone is not removed' "$refusal" 'no remote has'
}

survivesSpacesInPaths() {
  root="$laboratory/with space"
  mkdir -p "$root"
  makeRepository "$root/origin"
  git clone -q "$root/origin" "$root/my canonical" 2>/dev/null
  runIn "$root/my canonical" new lane >/dev/null 2>&1
  diagnosis=$( cd "$root/my canonical" && "$gitto" doctor lane 2>&1 )
  expectContains 'a clone under a path with a space is clean' "$diagnosis" 'nothing git can see'
  expectMissing 'no phantom host is reported at the space' "$diagnosis" 'hosts'
  removal=$( cd "$root/my canonical" && "$gitto" remove lane 2>&1 )
  expectContains 'and it can be removed' "$removal" 'removed'
}

makesSiblingsFromInsideAClone() {
  canonical=$(makeCanonical siblings)
  runIn "$canonical" new first >/dev/null 2>&1
  runIn "$canonical-first" new second >/dev/null 2>&1
  expectPath 'a clone made from inside a clone is a sibling' "$canonical-second/.gitto"
  expectNoPath 'and never a clone of the clone' "$canonical-first-second"
  recorded=$(cat "$canonical-second/.gitto")
  expectContains 'the new clone records the canonical' "$recorded" "$canonical"
}

namesABranchOfItsOwn() {
  canonical=$(makeCanonical branching)
  runIn "$canonical" new auth --branch feat/auth-token-refresh HEAD >/dev/null 2>&1
  branch=$(git -C "$canonical-auth" symbolic-ref --short HEAD)
  expectContains 'the branch can differ from the directory' "$branch" 'feat/auth-token-refresh'
}

recordsWhatTheCloneCost() {
  canonical=$(makeCanonical costing)
  runIn "$canonical" new lane >/dev/null 2>&1
  recorded=$(git -C "$canonical-lane" config --local --get gitto.diskKilobytesAtCreation)
  case "$recorded" in
    ''|*[!0-9]*) report fail 'a clone records what it cost' "got: $recorded" ;;
    *) report pass 'a clone records what it cost' ;;
  esac
  listing=$(runIn "$canonical" list 2>&1)
  expectContains 'and the listing shows what it cost when new' "$listing" 'new='
  expectContains 'alongside how long it has been idle' "$listing" 'idle='
  measured=$(runIn "$canonical" list --measure 2>&1)
  expectContains 'and --measure says what it allocates now' "$measured" 'allocated='
}

emitsMachineReadableListing() {
  canonical=$(makeCanonical listing)
  runIn "$canonical" new first >/dev/null 2>&1
  runIn "$canonical" new second >/dev/null 2>&1

  output=$(runIn "$canonical" list --json)
  if printf '%s' "$output" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null; then
    report pass 'two clones still make valid json'
  else
    report fail 'two clones still make valid json' "$output"
  fi
  expectContains 'the listing names the canonical' "$output" '"canonical"'
  expectContains 'and carries the short name remove takes' "$output" '"name": "first"'
  expectContains 'and the second one too' "$output" '"name": "second"'
  expectContains 'and what the copy cost when new' "$output" '"diskKilobytesAtCreation"'
  expectContains 'and how long it has been idle' "$output" '"idleSeconds"'
}

reportsAStaleCanonical() {
  canonical=$(makeCanonical stale)
  printf 'two\n' > "$canonical/file.txt"
  git -C "$canonical" commit -qam second
  git -C "$canonical" push -q origin main
  git -C "$canonical" reset -q --hard HEAD~1
  listing=$(runIn "$canonical" list 2>&1)
  expectContains 'a canonical behind its upstream says so' "$listing" '1 behind'
  expectContains 'and points at the command that fixes it' "$listing" 'gitto sync'
}

bringsTheCanonicalUpToDate() {
  canonical=$(makeCanonical syncing)
  printf 'echo refreshed > refreshed.txt\n' > "$canonical/.gitto-refresh"
  git -C "$canonical" add .gitto-refresh
  git -C "$canonical" commit -qm refresh
  printf 'two\n' > "$canonical/file.txt"
  git -C "$canonical" commit -qam second
  git -C "$canonical" push -q origin main
  git -C "$canonical" reset -q --hard HEAD~2

  output=$(runIn "$canonical" sync 2>&1)
  expectContains 'sync moves the canonical forward' "$output" 'commits forward'
  expectContains 'and runs the refresh the project declares' "$output" '.gitto-refresh'
  expectPath 'which leaves its work behind' "$canonical/refreshed.txt"

  again=$(runIn "$canonical" sync 2>&1)
  expectContains 'a canonical already current says so' "$again" 'up to date'
}

prunesOnlyWhatIsMerged() {
  canonical=$(makeCanonical pruning)
  runIn "$canonical" new merged >/dev/null 2>&1
  runIn "$canonical" new ahead >/dev/null 2>&1
  printf 'work\n' > "$canonical-ahead/file.txt"
  git -C "$canonical-ahead" commit -qam work
  preview=$(runIn "$canonical" prune 2>&1)
  expectContains 'prune names a merged clone' "$preview" 'merged'
  expectMissing 'and leaves one holding commits alone' "$preview" 'ahead  ahead'
  expectPath 'nothing is deleted without --remove' "$canonical-merged/.gitto"
  runIn "$canonical" prune --remove >/dev/null 2>&1
  expectNoPath 'and --remove deletes it' "$canonical-merged"
  expectPath 'while the one with work survives' "$canonical-ahead/.gitto"
}

findsACanonicalThatMoved() {
  canonical=$(makeCanonical moving)
  runIn "$canonical" new lane >/dev/null 2>&1
  mv "$canonical" "$canonical-elsewhere"
  refusal=$( ( cd "$canonical-lane" && "$gitto" list 2>&1 ) || true )
  expectContains 'a clone whose canonical vanished says so' "$refusal" 'records a canonical that is gone'
  ( cd "$canonical-lane" && "$gitto" adopt "$canonical-elsewhere" >/dev/null 2>&1 )
  listing=$( cd "$canonical-lane" && "$gitto" list 2>&1 )
  expectContains 'and adopt points it at the new place' "$listing" 'canonical'
}

printsItsVersion() {
  version=$("$gitto" version 2>&1)
  expectContains 'version prints one' "$version" 'gitto '
}

emitsAShellFunction() {
  output=$("$gitto" shell-init)
  expectContains 'shell-init defines the wrapper' "$output" 'gitto()'
  expectContains 'and completions' "$output" 'complete'
  for shell in bash zsh; do
    command -v "$shell" >/dev/null 2>&1 || continue
    if printf '%s\n' "$output" | "$shell" -n 2>/dev/null; then
      report pass "what it emits is valid $shell"
    else
      report fail "what it emits is valid $shell" "$shell -n rejected it"
    fi
  done
}

handlesCheckoutWithoutOrigin() {
  root="$laboratory/noremote"
  makeRepository "$root"
  refusal=$( ( cd "$root" && "$gitto" new lane 2>&1 ) || true )
  expectContains 'a checkout with no origin says so' "$refusal" 'no origin'
  expectNoPath 'and leaves nothing behind' "$root-lane"
  output=$( cd "$root" && "$gitto" new lane HEAD 2>&1 )
  expectContains 'naming a revision works without a remote' "$output" 'branch lane on HEAD'
}

leavesSubmodulesAloneForHead() {
  root="$laboratory/heads"
  mkdir -p "$root"
  makeRepository "$root/sub"
  makeRepository "$root/origin"
  git -C "$root/origin" submodule add -q "$root/sub" vendor/sub
  git -C "$root/origin" commit -qm submodule
  git clone -q --recursive "$root/origin" "$root/canonical" 2>/dev/null
  printf 'two\n' > "$root/canonical/vendor/sub/file.txt"
  git -C "$root/canonical/vendor/sub" commit -qam ahead
  ahead=$(git -C "$root/canonical/vendor/sub" rev-parse HEAD)
  runIn "$root/canonical" new asis HEAD >/dev/null 2>&1
  kept=$(git -C "$root/canonical-asis/vendor/sub" rev-parse HEAD)
  if [ "$kept" = "$ahead" ]; then
    report pass 'HEAD leaves a submodule where the canonical had it'
  else
    report fail 'HEAD leaves a submodule where the canonical had it' "wanted $ahead, got $kept"
  fi
}

reportsPlantedReferences() {
  canonical=$(makeCanonical planted)
  runIn "$canonical" new clean >/dev/null 2>&1
  clean=$( cd "$canonical" && "$gitto" doctor clean 2>&1 )
  expectContains 'a clean clone reports nothing' "$clean" 'nothing git can see'
  ln -s file.txt "$canonical-clean/nearby"
  relative=$( cd "$canonical" && "$gitto" doctor clean 2>&1 )
  expectContains 'a relative symlink inside the clone is left alone' "$relative" 'nothing git can see'

  ln -s "$canonical/file.txt" "$canonical-clean/borrowed"
  planted=$( cd "$canonical" && "$gitto" doctor clean 2>&1 )
  expectContains 'a symlink into the canonical is reported' "$planted" 'symlink'
}

everyManifestAgreesOnTheVersion() {
  repository=$(cd "$(dirname "$0")/.." && pwd)
  declared=$("$gitto" version | awk '{print $2}')
  for manifest in plugins/gitto/plugin.json plugins/gitto/.claude-plugin/plugin.json; do
    stated=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$repository/$manifest" | head -1)
    if [ "$stated" = "$declared" ]; then
      report pass "$manifest agrees the version is $declared"
    else
      report fail "$manifest agrees the version is $declared" "it says $stated"
    fi
  done
}

keepsItsMarkerOutOfTheWay() {
  canonical=$(makeCanonical marker)
  runIn "$canonical" new lane >/dev/null 2>&1
  clone="$canonical-lane"

  expectPath 'a clone records where it came from' "$clone/.gitto"
  recorded=$(cat "$clone/.gitto")
  expectContains 'and the record names the canonical' "$recorded" "$canonical"

  status=$(git -C "$clone" status --porcelain)
  if [ -z "$status" ]; then
    report pass 'the record leaves the clone clean'
  else
    report fail 'the record leaves the clone clean' "git status: $status"
  fi

  tracked=$(git -C "$clone" status --porcelain -- .gitignore)
  if [ -z "$tracked" ]; then
    report pass 'and never edits a file the project commits'
  else
    report fail 'and never edits a file the project commits' ".gitignore changed: $tracked"
  fi
}

refusesWhenBlocksCannotBeShared() {
  if [ -n "${GITTO_TEST_PLAIN_FILESYSTEM:-}" ]; then
    checkRefusalOn "$GITTO_TEST_PLAIN_FILESYSTEM"
    return
  fi

  image=$(mktemp -d)/nocow.dmg
  mount=/Volumes/GittoNoCow
  hdiutil create -quiet -size 256m -fs HFS+ -volname GittoNoCow "$image" >/dev/null 2>&1 || {
    report pass 'a filesystem without block sharing is refused (skipped, no plain filesystem)'
    return
  }
  hdiutil attach -quiet -nobrowse "$image" >/dev/null 2>&1
  checkRefusalOn "$mount"
  hdiutil detach -quiet "$mount" >/dev/null 2>&1 || true
}

checkRefusalOn() {
  plainRoot="$1/gitto-tests.$$"
  mkdir -p "$plainRoot"
  canonical=$(makeCanonical flat "$plainRoot")
  output=$(runIn "$canonical" new lane 2>&1 || true)
  expectContains 'a filesystem without block sharing is refused' "$output" 'costs the full size'
  expectNoPath 'and leaves nothing behind' "$canonical-lane"
  rm -rf "$plainRoot"
}

printf 'gitto tests\n\n'
readsSettingsGitCannotSee() {
  canonical=$(makeCanonical settings)
  runIn "$canonical" new lane >/dev/null
  lane=$(cd "$canonical-lane" && pwd -P)

  quiet=$(HOME="$laboratory/empty-home" runIn "$canonical" doctor lane 2>&1)
  expectContains 'a settings file nobody wrote is not reported' "$quiet" 'nothing git can see'

  mkdir -p "$laboratory/planted-home/.ssh"
  printf 'Host box\n  ProxyCommand %s/tools/wrapper %%h\n' "$lane" \
    > "$laboratory/planted-home/.ssh/config"
  found=$(HOME="$laboratory/planted-home" runIn "$canonical" doctor lane 2>&1)
  expectContains 'a settings file naming the clone is reported' "$found" 'outside git'
  expectContains 'and it says which file' "$found" '.ssh/config'
}

recordsWhatAdoptionCost() {
  canonical=$(makeCanonical cost)
  git -C "$canonical" worktree add --quiet -b taken "$canonical-taken" >/dev/null 2>&1
  runIn "$canonical-taken" adopt "$canonical" >/dev/null

  listing=$(runIn "$canonical" list --json)
  expectMissing 'an adopted clone carries a disk figure' "$listing" '"diskKilobytesAtCreation": null'
  expectContains 'and the clone is in the listing' "$listing" '"name": "taken"'
}

refusesToUpdateAScriptThatFollowsACheckout() {
  mkdir -p "$laboratory/bin"
  ln -sf "$gitto" "$laboratory/bin/gitto"
  refusal=$("$laboratory/bin/gitto" update 2>&1 || true)
  expectContains 'a linked script is not replaced' "$refusal" 'symbolic link into a checkout'
  expectPath 'and the link is still a link' "$laboratory/bin/gitto"
  expectContains 'and it still points at the checkout' "$(readlink "$laboratory/bin/gitto")" 'scripts/gitto'
}

adoptsAWorktreeInPlace() {
  canonical=$(makeCanonical nest)
  host=$(dirname "$canonical")/nest-host
  git clone -q "$(git -C "$canonical" config remote.origin.url)" "$host"
  leaf=$(dirname "$canonical")/nest-leaf
  git -C "$host" worktree add -q "$leaf" -b fix/leaf-holds-a-slash
  printf 'local\n' >> "$leaf/file.txt"
  printf 'x\n' > "$leaf/untracked.txt"
  before=$(git -C "$leaf" status --porcelain)

  runIn "$leaf" adopt "$canonical" >/dev/null 2>&1

  expectPath 'the directory stays where it was' "$leaf"
  expectPath 'and gets a repository of its own' "$leaf/.git/HEAD"
  expectEqual 'every change survives exactly' "$before" "$(git -C "$leaf" status --porcelain)"
  expectEqual 'the branch survives' 'fix/leaf-holds-a-slash' "$(git -C "$leaf" rev-parse --abbrev-ref HEAD)"
  expectEqual 'the host stops registering it' '1' "$(git -C "$host" worktree list | wc -l | tr -d ' ')"
  expectEqual 'it records where it came from' "$(cd "$canonical" && pwd -P)" "$(cat "$leaf/.gitto")"
  expectMissing 'and the record stays out of git status' "$(git -C "$leaf" status --porcelain)" '.gitto'
  expectMissing 'and no scaffolding refs are left behind' \
    "$(git -C "$leaf" for-each-ref --format='%(refname)' 2>/dev/null)" 'gitto-adopted'
  expectMissing 'at any submodule depth either' \
    "$(git -C "$leaf" submodule foreach --recursive --quiet 'git for-each-ref --format="%(refname)"' 2>/dev/null)" 'gitto-adopted'
}

refusesToAdoptWhatIsAlreadyIndependent() {
  canonical=$(makeCanonical solo)
  output=$(runIn "$canonical" adopt "$canonical" 2>&1 || true)
  expectContains 'says it is neither a clone nor a worktree' "$output" 'worktree'
}

makeNestedWorktree() {
  root="$laboratory/$1"
  mkdir -p "$root"
  makeRepository "$root/deep"
  makeRepository "$root/middle"
  git -C "$root/middle" submodule add -q "$root/deep" vendor/deep
  git -C "$root/middle" commit -qm submodule
  makeRepository "$root/origin"
  git -C "$root/origin" submodule add -q "$root/middle" vendor/middle
  git -C "$root/origin" commit -qm submodule
  git clone -q --recursive "$root/origin" "$root/canonical" 2>/dev/null
  git clone -q "$root/origin" "$root/host" 2>/dev/null
  git -C "$root/host" worktree add -q "$root/leaf" -b leaf 2>/dev/null
  git -C "$root/leaf" submodule update -q --init --recursive 2>/dev/null
  echo "$root"
}

leavesIndependentSubmodulesAlone() {
  root=$(makeNestedWorktree independent)
  inner=$root/leaf/vendor/middle/vendor/deep
  rm -f "$inner/.git"
  git clone -q "$root/deep" "$root/spare" 2>/dev/null
  mv "$root/spare/.git" "$inner/.git"
  rm -rf "$root/spare"

  runIn "$root/leaf" adopt "$root/canonical" >/dev/null 2>&1

  expectPath 'the worktree still becomes a clone' "$root/leaf/.git/HEAD"
  expectPath 'and a submodule holding its own repository keeps it' "$inner/.git/HEAD"
}

restoresEverySubmoduleMarkerWhenItGivesUp() {
  root=$(makeNestedWorktree giveup)
  shallow=$root/leaf/vendor/middle
  deep=$root/leaf/vendor/middle/vendor/deep
  beforeMarker=$(cat "$shallow/.git")

  chmod 444 "$deep/.git"
  runIn "$root/leaf" adopt "$root/canonical" >/dev/null 2>&1 || true
  chmod 644 "$deep/.git" 2>/dev/null || true

  expectContains 'it goes back to being a worktree' "$(cat "$root/leaf/.git")" 'worktrees'
  expectEqual 'and puts every submodule marker back' "$beforeMarker" "$(cat "$shallow/.git")"
  if git -C "$root/leaf" submodule status --recursive >/dev/null 2>&1; then
    report pass 'so the worktree reads normally again'
  else
    report fail 'so the worktree reads normally again' 'submodule status still fails'
  fi
}

namesTheWorktreesTheCanonicalHosts() {
  canonical=$(makeCanonical hostsnamed)
  root=$(dirname "$canonical")
  git -C "$canonical" worktree add -q "$root/outside" -b outside 2>/dev/null

  diagnosis=$(runIn "$canonical" doctor 2>&1)

  expectContains 'doctor looks at the canonical, not only at clones' "$diagnosis" 'canonical'
  expectContains 'and names the worktree it hosts outside itself' "$diagnosis" "$root/outside"
}

saysTheCanonicalHostsNothingWhenItDoesNot() {
  canonical=$(makeCanonical hostsnothing)

  diagnosis=$(runIn "$canonical" doctor 2>&1)

  expectContains 'a canonical hosting nothing says so' "$diagnosis" 'hosts no worktree'
  expectMissing 'and reports no marker trouble' "$diagnosis" 'its marker points'
}

catchesAMarkerPointingAtAnotherCheckout() {
  canonical=$(makeCanonical markermoved)
  root=$(dirname "$canonical")
  git -C "$canonical" worktree add -q "$root/outside" -b outside 2>/dev/null
  makeRepository "$root/occupant"
  printf 'gitdir: %s\n' "$root/occupant/.git" > "$root/outside/.git"

  diagnosis=$(runIn "$canonical" doctor 2>&1)

  expectContains 'a marker resolving to a checkout that never registered it is reported' \
    "$diagnosis" 'is not this checkout'
  expectContains 'and the report names where it points' "$diagnosis" "$root/occupant/.git"
}

catchesAMarkerWhoseTargetIsGone() {
  canonical=$(makeCanonical markergone)
  root=$(dirname "$canonical")
  git -C "$canonical" worktree add -q "$root/outside" -b outside 2>/dev/null
  printf 'gitdir: %s\n' "$root/nowhere/.git/worktrees/outside" > "$root/outside/.git"

  diagnosis=$(runIn "$canonical" doctor 2>&1)

  expectContains 'a marker pointing at a gitdir that is gone is reported' "$diagnosis" 'which is gone'
}

namesAHostedWorktreeWhoseDirectoryVanished() {
  canonical=$(makeCanonical hostedgone)
  root=$(dirname "$canonical")
  git -C "$canonical" worktree add -q "$root/outside" -b outside 2>/dev/null
  rm -rf "$root/outside"

  diagnosis=$(runIn "$canonical" doctor 2>&1)

  expectContains 'a registration whose directory vanished is reported' "$diagnosis" 'nothing is there'
}

seesAWorktreeHostedAtSubmoduleDepth() {
  root=$(makeNestedWorktree deephost)
  git -C "$root/canonical/vendor/middle" worktree add -q "$root/deepleaf" -b deepleaf 2>/dev/null

  diagnosis=$(runIn "$root/canonical" doctor 2>&1)

  expectContains 'a worktree a submodule registers is named too' "$diagnosis" "$root/deepleaf"
}

refusesToLoseWorkInsideASubmodule() {
  root="$laboratory/submodulework"
  mkdir -p "$root"
  makeRepository "$root/dependency"
  makeRepository "$root/source"
  git -C "$root/source" submodule add -q "$root/dependency" vendor/dependency
  git -C "$root/source" commit -qm submodule
  git clone -q --bare "$root/source" "$root/origin" 2>/dev/null
  git clone -q "$root/origin" "$root/canonical" 2>/dev/null
  canonical="$root/canonical"
  git -C "$canonical" submodule update -q --init --recursive
  runIn "$canonical" new lane >/dev/null 2>&1

  printf 'scratch\n' > "$canonical-lane/vendor/dependency/scratch.txt"
  refusal=$( ( cd "$canonical" && "$gitto" remove lane 2>&1 ) || true )
  expectContains 'untracked work inside a submodule is seen' "$refusal" 'uncommitted changes'
  expectContains 'and the refusal names where it is' "$refusal" 'vendor/dependency'
  rm -f "$canonical-lane/vendor/dependency/scratch.txt"

  printf 'work\n' > "$canonical-lane/vendor/dependency/file.txt"
  git -C "$canonical-lane/vendor/dependency" commit -qam 'only this clone has it'
  git -C "$canonical-lane" add vendor/dependency
  git -C "$canonical-lane" commit -qm 'bump the pointer'
  git -C "$canonical-lane" push -q origin lane

  refusal=$( ( cd "$canonical" && "$gitto" remove lane 2>&1 ) || true )
  expectContains 'a submodule commit no remote has stops the removal' "$refusal" 'no remote has'
  expectPath 'so the clone is still there' "$canonical-lane/.gitto"
}

refusesToLoseWorkOnABranchWithNoUpstream() {
  canonical=$(makeCanonical noupstream)
  runIn "$canonical" new lane HEAD >/dev/null 2>&1
  printf 'work\n' > "$canonical-lane/second.txt"
  git -C "$canonical-lane" add -A && git -C "$canonical-lane" commit -qm second

  refusal=$( ( cd "$canonical" && "$gitto" remove lane 2>&1 ) || true )
  expectContains 'a commit no remote has is refused without an upstream to compare' "$refusal" 'no remote has'
  expectPath 'and the clone survives' "$canonical-lane/.gitto"
}

keepsWhatItArchives() {
  canonical=$(makeCanonical archiving)
  runIn "$canonical" new lane >/dev/null 2>&1
  printf 'edited\n' > "$canonical-lane/file.txt"
  printf 'never committed\n' > "$canonical-lane/untracked.txt"

  output=$( ( cd "$canonical" && "$gitto" remove lane --archive 2>&1 ) )
  expectNoPath 'the clone is gone' "$canonical-lane"
  archive=$(printf '%s' "$output" | sed -n 's/.*is in //p')
  expectPath 'and a bundle stands where it said' "$archive/superproject.bundle"
  expectPath 'beside a manifest of what it holds' "$archive/manifest"

  restored="$laboratory/restored"
  git init -q "$restored"
  git -C "$restored" fetch -q "$archive/superproject.bundle" 'refs/gitto-archive/*:refs/gitto-archive/*' 2>/dev/null
  expectContains 'the edit nobody committed is in it' \
    "$(git -C "$restored" show refs/gitto-archive/uncommitted:file.txt 2>&1)" 'edited'
  expectContains 'and so is the file nobody tracked' \
    "$(git -C "$restored" show refs/gitto-archive/uncommitted:untracked.txt 2>&1)" 'never committed'
}

prunesWhatNobodyTouched() {
  canonical=$(makeCanonical staleprune)
  runIn "$canonical" new idle >/dev/null 2>&1
  printf 'work\n' > "$canonical-idle/file.txt"
  GIT_AUTHOR_DATE='2020-01-01T00:00:00' GIT_COMMITTER_DATE='2020-01-01T00:00:00' \
    git -C "$canonical-idle" commit -qam work
  touch -t 202001010000 "$canonical-idle/.git/logs/HEAD" "$canonical-idle"

  plain=$(runIn "$canonical" prune 2>&1)
  expectContains 'prune alone leaves a clone holding work' "$plain" 'nothing to prune'
  preview=$(runIn "$canonical" prune --stale 7 2>&1)
  expectContains 'and --stale names the one nobody touched' "$preview" 'untouched for'
  expectPath 'without deleting it' "$canonical-idle/.gitto"

  runIn "$canonical" prune --stale 7 --remove >/dev/null 2>&1
  expectNoPath 'which --remove then takes' "$canonical-idle"
  expectPath 'after bundling what it held' "$(ls -d "$canonical.gitto-archive"/idle-* | head -1)/superproject.bundle"
}

waitsForWhoeverHoldsTheCanonical() {
  canonical=$(makeCanonical busy)
  mkdir -p "$canonical/.git/gitto-lock/writer"
  printf 'pid %s\nhost %s\nwhat gitto sync\n' "$$" "$(hostname)" \
    > "$canonical/.git/gitto-lock/writer/holder"

  refusal=$( ( cd "$canonical" && GITTO_LOCK_TIMEOUT=1 "$gitto" new lane 2>&1 ) || true )
  expectContains 'a clone waits for the run that holds the canonical' "$refusal" 'gitto sync'
  expectContains 'and says how long it waited' "$refusal" 'waited'
  expectNoPath 'and copies nothing meanwhile' "$canonical-lane"
}

takesALockNobodyIsHolding() {
  canonical=$(makeCanonical abandoned)
  mkdir -p "$canonical/.git/gitto-lock/writer"
  printf 'pid 999999\nhost %s\nwhat gitto sync\n' "$(hostname)" \
    > "$canonical/.git/gitto-lock/writer/holder"

  output=$(runIn "$canonical" new lane 2>&1)
  expectContains 'a lock whose holder died is taken' "$output" 'no longer running'
  expectPath 'and the clone is made' "$canonical-lane/.gitto"
  expectNoPath 'and the clone carries no lock of its own' "$canonical-lane/.git/gitto-lock"
}

saysWhatTheCanonicalIsBehind() {
  canonical=$(makeCanonical behindclone)
  printf 'two\n' > "$canonical/file.txt"
  git -C "$canonical" commit -qam second
  git -C "$canonical" push -q origin main
  git -C "$canonical" reset -q --hard HEAD~1

  output=$(runIn "$canonical" new lane 2>&1)
  expectContains 'a clone says how stale what it inherited is' "$output" 'commits behind'
  expectContains 'and what to run about it' "$output" 'gitto sync'
}

for testName in \
  carriesUntrackedState \
  resolvesNestedSubmodules \
  repointsHookPath \
  dropsNestedWorktrees \
  refusesToOrphanWorktrees \
  refusesToLoseWork \
  refusesToLoseWorkInsideASubmodule \
  refusesToLoseWorkOnABranchWithNoUpstream \
  keepsWhatItArchives \
  prunesWhatNobodyTouched \
  waitsForWhoeverHoldsTheCanonical \
  takesALockNobodyIsHolding \
  saysWhatTheCanonicalIsBehind \
  makesSiblingsFromInsideAClone \
  namesABranchOfItsOwn \
  recordsWhatTheCloneCost \
  emitsMachineReadableListing \
  reportsAStaleCanonical \
  bringsTheCanonicalUpToDate \
  prunesOnlyWhatIsMerged \
  findsACanonicalThatMoved \
  printsItsVersion \
  emitsAShellFunction \
  survivesSpacesInPaths \
  handlesCheckoutWithoutOrigin \
  leavesSubmodulesAloneForHead \
  reportsPlantedReferences \
  refusesWhenBlocksCannotBeShared \
  everyManifestAgreesOnTheVersion \
  keepsItsMarkerOutOfTheWay \
  adoptsAWorktreeInPlace \
  readsSettingsGitCannotSee \
  recordsWhatAdoptionCost \
  refusesToUpdateAScriptThatFollowsACheckout \
  refusesToAdoptWhatIsAlreadyIndependent \
  leavesIndependentSubmodulesAlone \
  restoresEverySubmoduleMarkerWhenItGivesUp \
  namesTheWorktreesTheCanonicalHosts \
  saysTheCanonicalHostsNothingWhenItDoesNot \
  catchesAMarkerPointingAtAnotherCheckout \
  catchesAMarkerWhoseTargetIsGone \
  namesAHostedWorktreeWhoseDirectoryVanished \
  seesAWorktreeHostedAtSubmoduleDepth
do
  reportsBefore=$((passed + failed))
  "$testName" || report fail "$testName" 'the test itself failed'
  [ $((passed + failed)) -gt "$reportsBefore" ] \
    || report fail "$testName" 'the test reported nothing, so it never reached an assertion'
done

printf '\n%d passed, %d failed\n' "$passed" "$failed"
[ "$failed" -eq 0 ]

